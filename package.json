{
  "name": "campuscare",
  "version": "1.0.0",
  "description": "CampusCare - College Complaint Management System",
  "type": "module",
  "scripts": {
    "start": "node server/src/server.js",
    "seed": "node server/src/db/seed.js",
    "build": "cd client && npm run build && mkdir -p ../server/public && cp -R dist/* ../server/public/",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "postinstall": "cd server && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": [
    "campuscare",
    "college",
    "complaint-management",
    "grievance-redressal",
    "full-stack"
  ],
  "author": "Google Antigravity Pair Programmer",
  "license": "ISC"
}
